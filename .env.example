POSTGRES_USER=ishelf
POSTGRES_PASSWORD=changeMe
POSTGRES_DB=ishelf
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low, medium or high (some models also accept minimal); lower is faster and cheaper
GEMINI_THINKING_LEVEL=low
# How many recipes a household may read from photos (each scan of 1-3 photos counts once)
RECIPE_SCAN_LIMIT=3
REFRESH_TOKEN_COOKIE_SECURE=true
# Push notifications: generate the keys with
# docker compose run --rm backend python -m application.notifications.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# E-mails (password reset, notices): SMTP of the provider (Brevo: smtp-relay.brevo.com, port 587).
# Without SMTP_HOST the e-mails are only written to the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=iShelf <noreply@ishelf.cz>
EMAIL_REPLY_TO=
APPLICATION_URL=http://localhost:5173
